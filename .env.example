# 複製成 .env 後填入。.env 不可上傳到 git 或公開。
# 金鑰留空，或 devices.json 沒有任何 deviceId → 自動進入「示範模式」(假資料)。

# --- 塗鴉雲端專案 (iot.tuya.com → Cloud → 你的專案 → Overview) ---
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# 資料中心，需與專案所屬區域一致：
#   中國       https://openapi.tuyacn.com
#   美西       https://openapi.tuyaus.com
#   美東       https://openapi-ueaz.tuyaus.com
#   中歐       https://openapi.tuyaeu.com
#   西歐       https://openapi-weaz.tuyaeu.com
#   印度       https://openapi.tuyain.com
#   新加坡     https://openapi-sg.iotbing.com
# 你的專案在新加坡 (網址 region=SG)。若 npm run probe 連不上，請以塗鴉後台 API Explorer 顯示的位址為準。
TUYA_BASE_URL=https://openapi-sg.iotbing.com

# --- 裝置 ---
# 產線、感測點名稱與各自的 Device ID 寫在 devices.json (不是這裡)。
SITE_TITLE=成型產線溫度監控
# 溫度資料點代碼的預設值；留空會自動偵測 (va_temperature / temp_current / temperature / temp_value)
TEMP_CODE=
# 原始值除以多少才是 °C。多數感測器回傳 253 代表 25.3°C → 10。用 npm run probe 確認。
TEMP_DIVISOR=10

# --- 行為 ---
PORT=3000
# 每幾秒向塗鴉取樣一次 (所有感測點一起查)。調到 20~30 才抓得到分鐘內的最高/最低，但 API 用量也加倍。
POLL_INTERVAL_SEC=60
# 與上一分鐘相差幾 °C 以上視為異常 (驟降/驟升)
ANOMALY_THRESHOLD_C=1.0
# 記憶體中保留幾天的資料供圖表查詢
RETAIN_DAYS=30
# 強制示範模式 (即使已填金鑰)
MOCK=0
